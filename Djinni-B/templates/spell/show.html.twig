{% extends 'base.html.twig' %}

{% block title %}Spell{% endblock %}

{% block body %}
    <h1>Spell</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ spell.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ spell.name }}</td>
            </tr>
            <tr>
                <th>Level</th>
                <td>{{ spell.level }}</td>
            </tr>
            <tr>
                <th>School</th>
                <td>{{ spell.school }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ spell.description }}</td>
            </tr>
            <tr>
                <th>Is_prepared</th>
                <td>{{ spell.isPrepared ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Has_limited_uses</th>
                <td>{{ spell.hasLimitedUses ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Max_charges</th>
                <td>{{ spell.maxCharges }}</td>
            </tr>
            <tr>
                <th>Current_charges</th>
                <td>{{ spell.currentCharges }}</td>
            </tr>
            <tr>
                <th>Casting_time</th>
                <td>{{ spell.castingTime }}</td>
            </tr>
            <tr>
                <th>Spell_range</th>
                <td>{{ spell.spellRange }}</td>
            </tr>
            <tr>
                <th>Components</th>
                <td>{{ spell.components }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ spell.duration }}</td>
            </tr>
            <tr>
                <th>Higer_level_description</th>
                <td>{{ spell.higerLevelDescription }}</td>
            </tr>
            <tr>
                <th>Recharge_type</th>
                <td>{{ spell.rechargeType }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_spell_index') }}">back to list</a>

    <a href="{{ path('app_spell_edit', {'id': spell.id}) }}">edit</a>

    {{ include('spell/_delete_form.html.twig') }}
{% endblock %}
