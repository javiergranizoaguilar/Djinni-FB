{% extends 'base.html.twig' %}

{% block title %}Proficency index{% endblock %}

{% block body %}
    <h1>Proficency index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Type</th>
                <th>Value_modifier</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for proficency in proficencies %}
            <tr>
                <td>{{ proficency.id }}</td>
                <td>{{ proficency.name }}</td>
                <td>{{ proficency.type }}</td>
                <td>{{ proficency.valueModifier }}</td>
                <td>
                    <a href="{{ path('app_proficency_show', {'id': proficency.id}) }}">show</a>
                    <a href="{{ path('app_proficency_edit', {'id': proficency.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_proficency_new') }}">Create new</a>
{% endblock %}
