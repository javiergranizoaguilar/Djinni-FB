{% extends 'base.html.twig' %}

{% block title %}Attack{% endblock %}

{% block body %}
    <h1>Attack</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ attack.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ attack.name }}</td>
            </tr>
            <tr>
                <th>Damage_dice</th>
                <td>{{ attack.damageDice ? attack.damageDice|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Damage_type</th>
                <td>{{ attack.damageType ? attack.damageType|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Range_</th>
                <td>{{ attack.range }}</td>
            </tr>
            <tr>
                <th>Is_saving_throw</th>
                <td>{{ attack.isSavingThrow ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ attack.description }}</td>
            </tr>
            <tr>
                <th>Attack_modifier</th>
                <td>{{ attack.attackModifier }}</td>
            </tr>
            <tr>
                <th>Saving_throw_tipe</th>
                <td>{{ attack.savingThrowTipe }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_attack_index') }}">back to list</a>

    <a href="{{ path('app_attack_edit', {'id': attack.id}) }}">edit</a>

    {{ include('attack/_delete_form.html.twig') }}
{% endblock %}
