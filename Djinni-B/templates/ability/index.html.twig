{% extends 'base.html.twig' %}

{% block title %}Ability index{% endblock %}

{% block body %}
    <h1>Ability index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Source_tipe</th>
                <th>Is_active</th>
                <th>Has_limited_uses</th>
                <th>Max_uses</th>
                <th>Current_uses</th>
                <th>Recharge_type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ability in abilities %}
            <tr>
                <td>{{ ability.id }}</td>
                <td>{{ ability.name }}</td>
                <td>{{ ability.description }}</td>
                <td>{{ ability.sourceTipe }}</td>
                <td>{{ ability.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ ability.hasLimitedUses ? 'Yes' : 'No' }}</td>
                <td>{{ ability.maxUses }}</td>
                <td>{{ ability.currentUses }}</td>
                <td>{{ ability.rechargeType }}</td>
                <td>
                    <a href="{{ path('app_ability_show', {'id': ability.id}) }}">show</a>
                    <a href="{{ path('app_ability_edit', {'id': ability.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ability_new') }}">Create new</a>
{% endblock %}
