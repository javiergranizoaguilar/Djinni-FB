{% extends 'base.html.twig' %}

{% block title %}CharacterSheetUser index{% endblock %}

{% block body %}
    <h1>CharacterSheetUser index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Visible</th>
                <th>Edit</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for character_sheet_user in character_sheet_users %}
            <tr>
                <td>{{ character_sheet_user.id }}</td>
                <td>{{ character_sheet_user.visible ? 'Yes' : 'No' }}</td>
                <td>{{ character_sheet_user.edit ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_character_sheet_user_show', {'id': character_sheet_user.id}) }}">show</a>
                    <a href="{{ path('app_character_sheet_user_edit', {'id': character_sheet_user.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_character_sheet_user_new') }}">Create new</a>
{% endblock %}
