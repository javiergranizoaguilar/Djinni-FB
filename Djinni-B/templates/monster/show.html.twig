{% extends 'base.html.twig' %}

{% block title %}Monster{% endblock %}

{% block body %}
    <h1>Monster</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ monster.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ monster.name }}</td>
            </tr>
            <tr>
                <th>Source_book</th>
                <td>{{ monster.sourceBook }}</td>
            </tr>
            <tr>
                <th>Size</th>
                <td>{{ monster.size }}</td>
            </tr>
            <tr>
                <th>Page_number</th>
                <td>{{ monster.pageNumber }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ monster.type }}</td>
            </tr>
            <tr>
                <th>Alignment</th>
                <td>{{ monster.alignment }}</td>
            </tr>
            <tr>
                <th>Armor_class</th>
                <td>{{ monster.armorClass }}</td>
            </tr>
            <tr>
                <th>Ac_description</th>
                <td>{{ monster.acDescription }}</td>
            </tr>
            <tr>
                <th>Hit_points_average</th>
                <td>{{ monster.hitPointsAverage }}</td>
